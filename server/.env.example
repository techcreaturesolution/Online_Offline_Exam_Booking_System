PORT=5000
# Set to the number of reverse proxies in front of the API (e.g. 1) so rate limits see the real client IP
TRUST_PROXY=0
MONGO_URI=mongodb://127.0.0.1:27017/thespot_exam_booking
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_URL=http://localhost:5173
# Let universities / institutes register themselves (Super Admin approves them)
ALLOW_INSTITUTE_SIGNUP=true
# Optional: e-mail copies of in-app notifications. Leave empty to use in-app notifications only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=TheSpot Exam Booking <no-reply@thespotexam.com>
